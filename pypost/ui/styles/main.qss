/* PyPost Default Styles */

/*
   Tab close-button icons. The icon scales into the rectangle sized by the
   active QStyle's PM_TabCloseIndicator metrics.

   Do NOT style QTabBar::tab here: setting any box-model property on that
   sub-control disables native tab rendering, collapsing tabs to bare text
   width so labels concatenate (PYPOST-792).
*/

QTabBar::close-button {
    image: url(%ICONS_DIR%/close.svg);
}

QTabBar::close-button:hover {
    image: url(%ICONS_DIR%/close-hover.svg);
}

/* Tree View Branch Indicators */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(%ICONS_DIR%/branch-closed.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(%ICONS_DIR%/branch-open.svg);
}

QTreeView::branch:has-children:!has-siblings:closed:hover,
QTreeView::branch:closed:has-children:has-siblings:hover {
    image: url(%ICONS_DIR%/branch-closed.svg);
}

QTreeView::branch:open:has-children:!has-siblings:hover,
QTreeView::branch:open:has-children:has-siblings:hover {
    image: url(%ICONS_DIR%/branch-open.svg);
}

/* Menu Styles */
QMenu::item {
    /* Top Right Bottom Left */
    padding: 8px 60px 8px 30px;
    margin: 2px;
}

QMenu::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

/* Variable hover tooltips (QToolTip.showText) and widget setToolTip hooks.
   Customize colors here; palette roles follow the active Qt theme. */
QToolTip {
    color: palette(tooltip-text);
    background-color: palette(tooltip-base);
    border: 1px solid palette(mid);
    padding: 4px;
}
